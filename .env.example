# Firebase Configuration
# Dapatkan nilai ini dari Firebase Console > Project Settings > Your Apps > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Mode: 'firebase' atau 'local' (default: local jika Firebase tidak dikonfigurasi)
NEXT_PUBLIC_STORAGE_MODE=local

# FCM Web Push certificate (Firebase Console > Project Settings > Cloud Messaging)
NEXT_PUBLIC_FCM_VAPID_KEY=your_vapid_key_here

# Sync Obsidian (server-side saja, jangan pakai prefix NEXT_PUBLIC_)
# SYNC_SECRET wajib diisi; tanpa ini /api/sync-obsidian menolak semua request (503).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Isi nilai yang sama di halaman Pengaturan aplikasi.
SYNC_SECRET=your_random_secret_here
GITHUB_TOKEN=your_fine_grained_token_here
GITHUB_OBSIDIAN_REPO=username/obsidian-vault
GITHUB_OBSIDIAN_BRANCH=main
